# ==========================================
# CRICKETGPT - PRODUCTION ENVIRONMENT CONFIG
# ==========================================

# --- Backend Config (FastAPI) ---
# Your Groq API Key (get it from console.groq.com)
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Server run configurations
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Comma-separated list of allowed origins for CORS security
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-deployment.vercel.app

# --- Frontend Config (Next.js) ---
# Public API URL pointing to the deployed backend FastAPI server
NEXT_PUBLIC_API_URL=https://your-backend-deployment.onrender.com
