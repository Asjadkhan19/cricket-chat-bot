# Backend environment variables
# Host address for the FastAPI server (0.0.0.0 binds to all interfaces)
HOST=0.0.0.0
# Port the FastAPI server listens on
PORT=8000
# Deployment stage (production, development, etc.)
ENVIRONMENT=production
# Comma‑separated list of allowed CORS origins for the API
ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app
# Groq API key (replace with your actual key in a real .env file)
GROQ_API_KEY=your_groq_api_key_here
